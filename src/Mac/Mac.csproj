<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Mixamp</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" /><FrameworkReference Include="Microsoft.AspNetCore.App" /><ProjectReference Include="../Core/Core.csproj" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <Compile Include="../Mixamp/Account.cs" Link="Account.cs" />
    <Content Include="../Assets/MixampMeter.ttf" Link="wwwroot/MixampMeter.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Assets/Ubuntu/*.ttf" Link="wwwroot/fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/mixtape.png" Link="wwwroot/mixtape.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
<ItemGroup><Compile Include="../Casting/*.cs" Link="Casting/%(Filename)%(Extension)" /><PackageReference Include="Sharpcaster" Version="3.0.0" /></ItemGroup></Project>
