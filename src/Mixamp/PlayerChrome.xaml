<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="PlayerMenuItem" TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid>
    <Border x:Name="surface" Background="Transparent" CornerRadius="3" Padding="8,5">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid x:Name="mark" Width="20"><Path x:Name="tick" Visibility="Hidden" Stroke="{DynamicResource Accent}" StrokeThickness="2" Data="M 1,6 L 4,9 L 10,2" VerticalAlignment="Center"/></Grid>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      <TextBlock x:Name="gesture" Grid.Column="2" Margin="16,0,0,0" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}"/>
      <Path x:Name="arrow" Grid.Column="3" Margin="10,0,0,0" Visibility="Hidden" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Muted}" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=surface}" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
     <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="mark" Property="Visibility" Value="Collapsed"/><Setter TargetName="arrow" Property="Visibility" Value="Collapsed"/><Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/></Trigger>
    <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="arrow" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="tick" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="surface" Property="Background" Value="{DynamicResource Tint}"/></Trigger>
    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="surface" Property="Background" Value="{DynamicResource Tint}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value=".55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TransportKey" TargetType="Button">
  <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="2,0"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent">
    <Ellipse x:Name="disc" Fill="{TemplateBinding Background}"/>
    <Ellipse x:Name="focus" StrokeThickness="1" Margin="1"/>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="focus" Property="Stroke" Value="{DynamicResource Muted}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Stroke" Value="{DynamicResource Ink}"/><Setter TargetName="focus" Property="StrokeThickness" Value="2"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="disc" Property="Opacity" Value=".75"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PlayKey" TargetType="Button" BasedOn="{StaticResource TransportKey}">
  <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Background" Value="{DynamicResource Accent}"/>
 </Style>
 <Style x:Key="VolumeRail" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
   <Grid Background="Transparent"><Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{TemplateBinding Background}"/></Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PlayerFader" TargetType="Slider">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
   <Grid Background="Transparent">
    <Border x:Name="focus" BorderThickness="1" CornerRadius="4"/>
    <Track x:Name="PART_Track" Margin="3,0">
     <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource VolumeRail}" Background="{DynamicResource Accent}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource VolumeRail}" Background="{DynamicResource Muted}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb Width="11"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Height="11" Fill="{DynamicResource Accent}" Stroke="{DynamicResource Paper}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    </Track>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
